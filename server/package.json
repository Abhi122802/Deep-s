{
  "name": "deeps-cake-shop-server",
  "version": "1.0.0",
  "description": "Backend API for Deep's Cake Shop with Node.js, Express, TypeScript, and MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
