# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/deeps_cake_shop
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/deeps_cake_shop?retryWrites=true&w=majority
# Note: If password contains special characters like '@', URL-encode it (e.g. '@' becomes '%40')
MONGODB_URI=mongodb://127.0.0.1:27017/deeps_cake_shop

# Frontend CORS URL
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secret (for Admin API)
JWT_SECRET=your_jwt_secret_key_change_in_production_32chars

# Cloudinary Storage Configuration (Optional for Custom Cake Reference Images)
# If omitted or left empty, the server automatically saves uploads to server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer Notification Settings (Phase 4)
# Default is 'mock' for safe local development and testing (zero external messages sent)
NOTIFICATION_MODE=mock
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_MESSAGING_PROVIDER=mock

# Production Email Credentials (Required ONLY if NOTIFICATION_MODE=production and NOTIFICATION_EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@deepscakeshop.in

# Production Messaging Credentials (Required ONLY if NOTIFICATION_MODE=production and NOTIFICATION_MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
