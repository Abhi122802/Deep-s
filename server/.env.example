# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/deeps_cake_shop
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/deeps_cake_shop?retryWrites=true&w=majority
# Note: If password contains special characters like '@', URL-encode it (e.g. '@' becomes '%40')
MONGODB_URI=mongodb://127.0.0.1:27017/deeps_cake_shop

# Frontend CORS URL
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secret (for Admin API)
JWT_SECRET=your_jwt_secret_key_change_in_production_32chars

# Cloudinary Storage Configuration (Optional for Custom Cake Reference Images)
# If omitted or left empty, the server automatically saves uploads to server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer Notification Settings (Phase 4)
# Default is 'mock' for safe local development and testing (zero external messages sent)
NOTIFICATION_MODE=mock
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_MESSAGING_PROVIDER=mock

# Production Email Credentials (Required ONLY if NOTIFICATION_MODE=production and NOTIFICATION_EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@deepscakeshop.in

# Production Messaging Credentials (Required ONLY if NOTIFICATION_MODE=production and NOTIFICATION_MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Webhook and WhatsApp Integration Settings (Phase 5, Milestone 2)
# SendGrid Event Webhook ECDSA Public Key in Base64 (Required ONLY for SendGrid webhook verification)
SENDGRID_WEBHOOK_VERIFICATION_KEY=
# Twilio WhatsApp Sender Number in E.164 format (e.g. whatsapp:+14155238886; Required ONLY for WhatsApp messaging)
TWILIO_WHATSAPP_NUMBER=
# Public API Base URL (e.g. https://api.deepscakeshop.in; Required for external webhook delivery callbacks)
PUBLIC_API_URL=

# Production Reliability & Security Hardening (Phase 5, Milestone 1)
# Reverse Proxy Trust Setting:
# - '0' or 'false': Direct public exposure (no upstream reverse proxy; prevents IP spoofing)
# - '1' or 'true': Standard single reverse proxy hop (Cloudflare, AWS ALB, Nginx, Render, Heroku)
# - '2' or higher: Multi-hop proxy architectures
# - IP/Subnet: e.g. '127.0.0.1', 'loopback', '10.0.0.0/8'
# CRITICAL: Set to '0' if the server is exposed directly to the internet without a reverse proxy.
TRUST_PROXY=1

# Notification Recovery Background Interval (Milliseconds; default 300000 = 5 minutes)
NOTIFICATION_RECOVERY_INTERVAL_MS=300000

# Notification Drain Timeout on Shutdown (Milliseconds; default 10000 = 10s)
NOTIFICATION_DRAIN_TIMEOUT_MS=10000

# Structured Logging Configuration (Levels: debug, info, warn, error; Formats: json, pretty)
LOG_LEVEL=info
LOG_FORMAT=json
